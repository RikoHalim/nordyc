modules = ["python-3.12", "nodejs-22"]
run = ["node", "frontend/node_modules/vite/bin/vite.js", "frontend", "--config", "frontend/vite.config.ts", "--host", "0.0.0.0"]

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 8008
exposeLocalhost = false

[[ports]]
localPort = 55450
exposeLocalhost = false

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
BACKEND_ORIGIN = "http://127.0.0.1:8008"
FRONTEND_PORT = "5173"
API_ACCESS_MODE = "scoped"
ANALYSIS_EXTERNAL_PROCESSING_ALLOWED = "false"
RESEARCH_ENABLED = "false"
GEMINI_ENABLED = "false"
ANALYSIS_GEMINI_FALLBACK_ENABLED = "false"
ANALYSIS_MODEL_PROVIDER = "replit_claude"
CLAUDE_ENABLED = "true"
CLAUDE_MODEL = "claude-opus-5"
