# Phase 2 local development. Copy to .env and set both password values locally.
APP_ENV=development
POSTGRES_DB=shiftos
POSTGRES_USER=shiftos
POSTGRES_PORT=5432
# Required by Compose; an empty password prevents the database from starting.
POSTGRES_PASSWORD=
# Replace the placeholder with a URL-encoded copy of POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://shiftos:<URL_ENCODED_PASSWORD>@localhost:5432/shiftos
# Live fetching stays disabled until a publisher access/terms review is recorded.
DISCOVERY_ENABLED=false
DISCOVERY_TERMS_REVIEWED=false
# Set a nonempty local secret for shared/production catalogue job writes.
# CATALOGUE_WRITE_TOKEN=<SET_LOCALLY_DO_NOT_COMMIT>
# Private uploaded originals; HTTP/CLI only queue, the separate worker extracts.
CURRICULUM_UPLOAD_DIR=data/private/curriculum_uploads
# Phase 3 uses DATABASE_URL above. No LLM provider or API key is required.
# Evidence acquisition is explicitly invoked with ingest-evidence --live;
# per-dataset access/reuse/storage decisions are in data/evidence_acquisition.json.
# It never runs on startup and has no public HTTP ingestion endpoint.
# Keep data/raw and data/local private; do not put source credentials in a registry URL.
