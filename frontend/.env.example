# Development server only. The browser calls same-origin /api routes.
BACKEND_ORIGIN=http://127.0.0.1:8000
FRONTEND_PORT=5173
FRONTEND_HOST=127.0.0.1
# Provisional concept branding. Never put credentials in VITE_* variables.
VITE_BRAND_NAME=NORDYC
