# Development server only. The browser calls same-origin /api routes.
BACKEND_ORIGIN=http://127.0.0.1:8000
FRONTEND_PORT=5173
FRONTEND_HOST=127.0.0.1
# Optional local synthetic demo only: skips manual credential entry.
# Server-only path to a running preview's auth.private.json; never use VITE_*.
# Requires its ready, synthetic, mocked, provider-HTTP-blocked receipt.json.
# SHIFTOS_LOCAL_DEMO_AUTH_FILE=../data/local/your-preview/auth.private.json
# Provisional concept branding. Never put credentials in VITE_* variables.
VITE_BRAND_NAME=NORDYC
# Optional approved asset placed in frontend/public. Only a local path is accepted.
# VITE_BRAND_LOGO_PATH=/brand/approved-logo.svg
